#validating a password
#the length of the password must not exceed 12 characters
#the user name must have atleast one number
#the user name must have atleast one special character
run=True

print("**** password checker ****")

while run:
    password=input("ENTER A VALID PASSWORD :");
    length=len(password)
    if length>12:
        print(f"{password} has exceeded 12 characters")

    elif any(char in "12343567890"for char in password)==False:
        print("the password must contain atleast one number")

    elif any(char in "!@#$%^&*()_+-=" for char in password)==False:
        print("the password must contain atleast one character")



    else:
        print(f"your password has been set as {password}")
        run=False
